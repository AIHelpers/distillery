{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Distillery Training Job Config",
  "description": "The only interface contract between Go (Distillery core) and Python (trainer worker). Written by the Go local_trainer adapter into job-dir/config.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "base_model",
    "language",
    "skill",
    "dataset_path",
    "output_dir"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "base_model": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "python",
        "go",
        "javascript",
        "typescript",
        "java",
        "csharp",
        "rust",
        "cpp"
      ]
    },
    "skill": {
      "type": "string",
      "enum": [
        "code_generation",
        "code_completion",
        "bug_fixing",
        "optimization",
        "documentation"
      ]
    },
    "dataset_path": {
      "type": "string"
    },
    "output_dir": {
      "type": "string"
    },
    "epochs": {
      "type": "integer",
      "minimum": 1
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "learning_rate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "warmup_steps": {
      "type": "integer",
      "minimum": 0
    },
    "max_sequence_length": {
      "type": "integer",
      "minimum": 1
    },
    "gradient_accumulation_steps": {
      "type": "integer",
      "minimum": 1
    },
    "weight_decay": {
      "type": "number",
      "minimum": 0
    },
    "scheduler_type": {
      "type": "string",
      "enum": [
        "linear",
        "cosine",
        "constant"
      ]
    },
    "optimizer_type": {
      "type": "string",
      "enum": [
        "adam",
        "adamw"
      ]
    },
    "use_lora": {
      "type": "boolean"
    },
    "lora_rank": {
      "type": "integer",
      "minimum": 1
    },
    "lora_alpha": {
      "type": "integer",
      "minimum": 1
    },
    "lora_dropout": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lora_target_mods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "load_4bit": {
      "type": "boolean"
    },
    "grad_checkpoint": {
      "type": "boolean"
    },
    "validation_split": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validate_every_steps": {
      "type": "integer",
      "minimum": 0
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_cache_dir": {
      "type": "string"
    },
    "resume_from": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "kind": {
      "type": "string",
      "description": "Model kind; selects the trainer task module.",
      "enum": [
        "causal_lm",
        "seq_classifier",
        "token_classifier",
        "embedding",
        "reranker",
        "preference_lm"
      ]
    },
    "max_length": {
      "type": "integer",
      "minimum": 1,
      "description": "seq_classifier: token truncation length."
    },
    "multi_label": {
      "type": "boolean"
    },
    "class_weights": {
      "type": "boolean"
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "export_onnx": {
      "type": "boolean"
    },
    "int8_quantize": {
      "type": "boolean"
    },
    "max_train_steps": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "type": "string",
      "enum": [
        "dpo",
        "orpo"
      ],
      "description": "preference_lm: DPO or ORPO."
    },
    "beta": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "preference_lm: DPO/ORPO temperature."
    },
    "max_prompt_len": {
      "type": "integer",
      "minimum": 1,
      "description": "preference_lm: max tokenized prompt length."
    },
    "max_len": {
      "type": "integer",
      "minimum": 1,
      "description": "preference_lm: max tokenized prompt+completion length."
    },
    "parent_job_id": {
      "type": "string",
      "description": "preference_lm (dpo): the parent SFT job ID (lineage)."
    },
    "parent_adapter_dir": {
      "type": "string",
      "description": "preference_lm (dpo): path to the parent job's saved LoRA adapter \u2014 the DPO starting policy."
    },
    "stride": {
      "type": "integer",
      "minimum": 0,
      "description": "token_classifier: sliding-window stride."
    },
    "label_scheme": {
      "type": "string",
      "description": "token_classifier: tagging scheme, e.g. BIO."
    },
    "max_seq_len": {
      "type": "integer",
      "minimum": 1,
      "description": "embedding/reranker: max tokenized sequence length."
    },
    "loss": {
      "type": "string",
      "description": "embedding/reranker: loss function name."
    },
    "hard_negatives": {
      "type": "boolean",
      "description": "embedding: enable hard-negative mining."
    },
    "matryoshka": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "embedding: Matryoshka truncation dimensions."
    },
    "grad_cache": {
      "type": "boolean",
      "description": "embedding/reranker: enable GradCache for large effective batch sizes."
    },
    "normalize": {
      "type": "boolean",
      "description": "embedding: L2-normalize output embeddings."
    },
    "json_schema": {
      "type": "string",
      "description": "causal_lm (Track B): JSON schema the task's outputs must satisfy."
    }
  }
}
