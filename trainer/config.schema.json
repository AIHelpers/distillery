{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Distillery Training Job Config",
  "description": "The only interface contract between Go (Distillery core) and Python (trainer worker). Written by the Go local_trainer adapter into job-dir/config.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "base_model",
    "language",
    "skill",
    "dataset_path",
    "output_dir"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "base_model": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "python",
        "go",
        "javascript",
        "typescript",
        "java",
        "csharp",
        "rust",
        "cpp"
      ]
    },
    "skill": {
      "type": "string",
      "enum": [
        "code_generation",
        "code_completion",
        "bug_fixing",
        "optimization",
        "documentation"
      ]
    },
    "dataset_path": {
      "type": "string"
    },
    "output_dir": {
      "type": "string"
    },
    "epochs": {
      "type": "integer",
      "minimum": 1
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "learning_rate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "warmup_steps": {
      "type": "integer",
      "minimum": 0
    },
    "max_sequence_length": {
      "type": "integer",
      "minimum": 1
    },
    "gradient_accumulation_steps": {
      "type": "integer",
      "minimum": 1
    },
    "weight_decay": {
      "type": "number",
      "minimum": 0
    },
    "scheduler_type": {
      "type": "string",
      "enum": [
        "linear",
        "cosine",
        "constant"
      ]
    },
    "optimizer_type": {
      "type": "string",
      "enum": [
        "adam",
        "adamw"
      ]
    },
    "use_lora": {
      "type": "boolean"
    },
    "lora_rank": {
      "type": "integer",
      "minimum": 1
    },
    "lora_alpha": {
      "type": "integer",
      "minimum": 1
    },
    "lora_dropout": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lora_target_mods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "load_4bit": {
      "type": "boolean"
    },
    "grad_checkpoint": {
      "type": "boolean"
    },
    "validation_split": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validate_every_steps": {
      "type": "integer",
      "minimum": 0
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_cache_dir": {
      "type": "string"
    },
    "resume_from": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "kind": {
      "type": "string",
      "description": "Model kind; selects the trainer task module.",
      "enum": [
        "causal_lm",
        "seq_classifier",
        "token_classifier",
        "embedding",
        "reranker",
        "preference_lm"
      ]
    },
    "max_length": {
      "type": "integer",
      "minimum": 1,
      "description": "seq_classifier: token truncation length."
    },
    "multi_label": {
      "type": "boolean"
    },
    "class_weights": {
      "type": "boolean"
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "export_onnx": {
      "type": "boolean"
    },
    "int8_quantize": {
      "type": "boolean"
    },
    "max_train_steps": {
      "type": "integer",
      "minimum": 1
    }
  }
}
